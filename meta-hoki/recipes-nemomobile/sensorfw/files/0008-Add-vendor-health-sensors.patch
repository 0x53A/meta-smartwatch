+#include "hybriscaloriesadaptor.h"
+#include "logging.h"
+#include "datatypes/utils.h"
+
+#define SENSOR_TYPE_CALORIES 65573
+
+HybrisCaloriesAdaptor::HybrisCaloriesAdaptor(const QString& id) :
+    HybrisAdaptor(id, SENSOR_TYPE_CALORIES)
+{
+    buffer = new DeviceAdaptorRingBuffer<CaloriesData>(1);
+    setAdaptedSensor("calories", "Calorie estimation", buffer);
+    setDescription("Hybris Calorie estimation sensor");
+    setInterval(0, 1000000);
+}
+
+HybrisCaloriesAdaptor::~HybrisCaloriesAdaptor() { delete buffer; }
+
+bool HybrisCaloriesAdaptor::startSensor()
+{
+    if (!(HybrisAdaptor::startSensor())) return false;
+    qCDebug(lcSensorFw) << "HybrisCaloriesAdaptor started";
+    return true;
+}
+
+void HybrisCaloriesAdaptor::sendInitialData()
+{
+    qCWarning(lcSensorFw) << "No initial data for Calorie estimation sensor";
+}
+
+void HybrisCaloriesAdaptor::stopSensor()
+{
+    HybrisAdaptor::stopSensor();
+    qCDebug(lcSensorFw) << "HybrisCaloriesAdaptor stopped";
+}
+
+void HybrisCaloriesAdaptor::processSample(const sensors_event_t& data)
+{
+    qCWarning(lcSensorFw) << "CALORIES RAW EVENT: type=" << data.type
+                  << " sensor=" << data.sensor
+                  << " timestamp=" << data.timestamp;
+    qCWarning(lcSensorFw) << "  data[0]=" << data.u.data[0]
+                  << " data[1]=" << data.u.data[1]
+                  << " data[2]=" << data.u.data[2]
+                  << " data[3]=" << data.u.data[3]
+                  << " data[4]=" << data.u.data[4]
+                  << " data[5]=" << data.u.data[5];
+
+    CaloriesData *d = buffer->nextSlot();
+    d->timestamp_ = quint64(data.timestamp * .001);
+    d->value_ = data.u.data[0];
+    d->status_ = (int)data.u.data[1];
+    buffer->commit();
+    buffer->wakeUpReaders();
+}
