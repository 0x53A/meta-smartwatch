index 0000000..0000001
--- /dev/null
+++ b/sensors/offbodysensor/offbodysensor.cpp
@@ -0,0 +1,78 @@
+#include "offbodysensor.h"
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "logging.h"
+
+OffBodySensorChannel::OffBodySensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<OffBodyData>(1),
+        previousValue_(0, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+    adaptor_ = sm.requestDeviceAdaptor("offbodyadaptor");
+    if (!adaptor_) { setValid(false); return; }
+
+    reader_ = new BufferReader<OffBodyData>(1);
+    outputBuffer_ = new RingBuffer<OffBodyData>(1);
+
+    filterBin_ = new Bin;
+    filterBin_->add(reader_, "offbody");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("offbody", "source", "buffer", "sink");
+    connectToSource(adaptor_, "offbody", reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+    outputBuffer_->join(this);
+
+    setDescription("Off-body detection sensor");
+    setRangeSource(adaptor_);
+    addStandbyOverrideSource(adaptor_);
+    setIntervalSource(adaptor_);
+    setValid(true);
+}
+
+OffBodySensorChannel::~OffBodySensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+        disconnectFromSource(adaptor_, "offbody", reader_);
+        sm.releaseDeviceAdaptor("offbodyadaptor");
+        delete reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool OffBodySensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting OffBodySensorChannel";
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool OffBodySensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping OffBodySensorChannel";
+    if (AbstractSensorChannel::stop()) {
+        adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void OffBodySensorChannel::emitData(const OffBodyData& value)
+{
+    if (value.value_ != previousValue_.value_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
