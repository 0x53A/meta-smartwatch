+#include "hybrisdailyrhradaptor.h"
+#include "logging.h"
+#include "datatypes/utils.h"
+
+#define SENSOR_TYPE_DAILYRHR 65581
+
+HybrisDailyRhrAdaptor::HybrisDailyRhrAdaptor(const QString& id) :
+    HybrisAdaptor(id, SENSOR_TYPE_DAILYRHR)
+{
+    buffer = new DeviceAdaptorRingBuffer<DailyRhrData>(1);
+    setAdaptedSensor("dailyrhr", "Daily resting heart rate", buffer);
+    setDescription("Hybris Daily resting heart rate sensor");
+    setInterval(0, 1000000);
+}
+
+HybrisDailyRhrAdaptor::~HybrisDailyRhrAdaptor() { delete buffer; }
+
+bool HybrisDailyRhrAdaptor::startSensor()
+{
+    if (!(HybrisAdaptor::startSensor())) return false;
+    qCDebug(lcSensorFw) << "HybrisDailyRhrAdaptor started";
+    return true;
+}
+
+void HybrisDailyRhrAdaptor::sendInitialData()
+{
+    qCWarning(lcSensorFw) << "No initial data for Daily resting heart rate sensor";
+}
+
+void HybrisDailyRhrAdaptor::stopSensor()
+{
+    HybrisAdaptor::stopSensor();
+    qCDebug(lcSensorFw) << "HybrisDailyRhrAdaptor stopped";
+}
+
+void HybrisDailyRhrAdaptor::processSample(const sensors_event_t& data)
+{
+    qCWarning(lcSensorFw) << "DAILYRHR RAW EVENT: type=" << data.type
+                  << " sensor=" << data.sensor
+                  << " timestamp=" << data.timestamp;
+    qCWarning(lcSensorFw) << "  data[0]=" << data.u.data[0]
+                  << " data[1]=" << data.u.data[1]
+                  << " data[2]=" << data.u.data[2]
+                  << " data[3]=" << data.u.data[3]
+                  << " data[4]=" << data.u.data[4]
+                  << " data[5]=" << data.u.data[5];
+
+    DailyRhrData *d = buffer->nextSlot();
+    d->timestamp_ = quint64(data.timestamp * .001);
+    d->value_ = data.u.data[0];
+    d->status_ = (int)data.u.data[1];
+    buffer->commit();
+    buffer->wakeUpReaders();
+}
