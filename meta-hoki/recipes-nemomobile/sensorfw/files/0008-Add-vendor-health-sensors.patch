--- /dev/null
+++ b/sensors/wristtempsensor/wristtempsensor.cpp
@@ -0,0 +1,78 @@
+#include "wristtempsensor.h"
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "logging.h"
+
+WristTempSensorChannel::WristTempSensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<WristTempData>(1),
+        previousValue_(0, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+    adaptor_ = sm.requestDeviceAdaptor("wristtempadaptor");
+    if (!adaptor_) { setValid(false); return; }
+
+    reader_ = new BufferReader<WristTempData>(1);
+    outputBuffer_ = new RingBuffer<WristTempData>(1);
+
+    filterBin_ = new Bin;
+    filterBin_->add(reader_, "wristtemp");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("wristtemp", "source", "buffer", "sink");
+    connectToSource(adaptor_, "wristtemp", reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+    outputBuffer_->join(this);
+
+    setDescription("On-wrist temperature sensor");
+    setRangeSource(adaptor_);
+    addStandbyOverrideSource(adaptor_);
+    setIntervalSource(adaptor_);
+    setValid(true);
+}
+
+WristTempSensorChannel::~WristTempSensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+        disconnectFromSource(adaptor_, "wristtemp", reader_);
+        sm.releaseDeviceAdaptor("wristtempadaptor");
+        delete reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool WristTempSensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting WristTempSensorChannel";
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool WristTempSensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping WristTempSensorChannel";
+    if (AbstractSensorChannel::stop()) {
+        adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void WristTempSensorChannel::emitData(const WristTempData& value)
+{
+    if (value.value_ != previousValue_.value_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
