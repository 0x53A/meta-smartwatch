+#include "hybrisrradaptor.h"
+#include "logging.h"
+#include "datatypes/utils.h"
+
+#define SENSOR_TYPE_RR 65574
+
+HybrisRespirationRateAdaptor::HybrisRespirationRateAdaptor(const QString& id) :
+    HybrisAdaptor(id, SENSOR_TYPE_RR)
+{
+    buffer = new DeviceAdaptorRingBuffer<RespirationRateData>(1);
+    setAdaptedSensor("rr", "Respiration rate", buffer);
+    setDescription("Hybris Respiration rate sensor");
+    setInterval(0, 1000000);
+}
+
+HybrisRespirationRateAdaptor::~HybrisRespirationRateAdaptor() { delete buffer; }
+
+bool HybrisRespirationRateAdaptor::startSensor()
+{
+    if (!(HybrisAdaptor::startSensor())) return false;
+    qCDebug(lcSensorFw) << "HybrisRespirationRateAdaptor started";
+    return true;
+}
+
+void HybrisRespirationRateAdaptor::sendInitialData()
+{
+    qCWarning(lcSensorFw) << "No initial data for Respiration rate sensor";
+}
+
+void HybrisRespirationRateAdaptor::stopSensor()
+{
+    HybrisAdaptor::stopSensor();
+    qCDebug(lcSensorFw) << "HybrisRespirationRateAdaptor stopped";
+}
+
+void HybrisRespirationRateAdaptor::processSample(const sensors_event_t& data)
+{
+    qCWarning(lcSensorFw) << "RR RAW EVENT: type=" << data.type
+                  << " sensor=" << data.sensor
+                  << " timestamp=" << data.timestamp;
+    qCWarning(lcSensorFw) << "  data[0]=" << data.u.data[0]
+                  << " data[1]=" << data.u.data[1]
+                  << " data[2]=" << data.u.data[2]
+                  << " data[3]=" << data.u.data[3]
+                  << " data[4]=" << data.u.data[4]
+                  << " data[5]=" << data.u.data[5];
+
+    RespirationRateData *d = buffer->nextSlot();
+    d->timestamp_ = quint64(data.timestamp * .001);
+    d->value_ = data.u.data[0];
+    d->status_ = (int)data.u.data[1];
+    buffer->commit();
+    buffer->wakeUpReaders();
+}
