new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/datatypes/calories.h
@@ -0,0 +1,54 @@
+#ifndef CALORIES_H
+#define CALORIES_H
+
+#include <QDBusArgument>
+#include <datatypes/caloriesdata.h>
+
+class Calories : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(float value READ value)
+    Q_PROPERTY(int status READ status)
+
+public:
+    Calories() {}
+    Calories(const CaloriesData& data) : QObject(), data_(data.timestamp_, data.value_, data.status_) {}
+    Calories(const Calories& other) : QObject(), data_(other.data_.timestamp_, other.data_.value_, other.data_.status_) {}
+
+    const CaloriesData& caloriesData() const { return data_; }
+    float value() const { return data_.value_; }
+    int status() const { return data_.status_; }
+
+    Calories& operator=(const Calories& origin)
+    {
+        data_ = origin.caloriesData();
+        return *this;
+    }
+
+private:
+    CaloriesData data_;
+    friend const QDBusArgument &operator>>(const QDBusArgument &argument, Calories& obj);
+};
+
+Q_DECLARE_METATYPE(Calories)
+
+inline QDBusArgument &operator<<(QDBusArgument &argument, const Calories &obj)
+{
+    argument.beginStructure();
+    argument << obj.caloriesData().value_ << obj.caloriesData().status_;
+    argument.endStructure();
+    return argument;
+}
+
+inline const QDBusArgument &operator>>(const QDBusArgument &argument, Calories &obj)
+{
+    double value; int status;
+    argument.beginStructure();
+    argument >> value >> status;
+    argument.endStructure();
+    obj.data_.value_ = value;
+    obj.data_.status_ = status;
+    return argument;
+}
+
+#endif // CALORIES_H
