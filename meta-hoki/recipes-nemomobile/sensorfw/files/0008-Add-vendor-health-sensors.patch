diff --git a/sensors/rrsensor/rrsensor.cpp b/sensors/rrsensor/rrsensor.cpp
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/sensors/rrsensor/rrsensor.cpp
@@ -0,0 +1,78 @@
+#include "rrsensor.h"
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "logging.h"
+
+RespirationRateSensorChannel::RespirationRateSensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<RespirationRateData>(1),
+        previousValue_(0, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+    adaptor_ = sm.requestDeviceAdaptor("rradaptor");
+    if (!adaptor_) { setValid(false); return; }
+
+    reader_ = new BufferReader<RespirationRateData>(1);
+    outputBuffer_ = new RingBuffer<RespirationRateData>(1);
+
+    filterBin_ = new Bin;
+    filterBin_->add(reader_, "rr");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("rr", "source", "buffer", "sink");
+    connectToSource(adaptor_, "rr", reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+    outputBuffer_->join(this);
+
+    setDescription("Respiration rate sensor");
+    setRangeSource(adaptor_);
+    addStandbyOverrideSource(adaptor_);
+    setIntervalSource(adaptor_);
+    setValid(true);
+}
+
+RespirationRateSensorChannel::~RespirationRateSensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+        disconnectFromSource(adaptor_, "rr", reader_);
+        sm.releaseDeviceAdaptor("rradaptor");
+        delete reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool RespirationRateSensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting RespirationRateSensorChannel";
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool RespirationRateSensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping RespirationRateSensorChannel";
+    if (AbstractSensorChannel::stop()) {
+        adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void RespirationRateSensorChannel::emitData(const RespirationRateData& value)
+{
+    if (value.value_ != previousValue_.value_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
diff --git a/sensors/rrsensor/rrsensor.h b/sensors/rrsensor/rrsensor.h
