+#ifndef BASALRHRSENSOR_CHANNEL_H
+#define BASALRHRSENSOR_CHANNEL_H
+
+#include <QObject>
+#include "deviceadaptor.h"
+#include "abstractsensor.h"
+#include "basalrhrsensor_a.h"
+#include "dataemitter.h"
+#include "datatypes/basalrhrdata.h"
+#include "datatypes/basalrhr.h"
+
+class Bin;
+template <class TYPE> class BufferReader;
+
+class BasalRhrSensorChannel :
+        public AbstractSensorChannel,
+        public DataEmitter<BasalRhrData>
+{
+    Q_OBJECT
+    Q_PROPERTY(BasalRhr basalrhr READ basalrhr)
+
+public:
+    static AbstractSensorChannel* factoryMethod(const QString& id)
+    {
+        BasalRhrSensorChannel* sc = new BasalRhrSensorChannel(id);
+        new BasalRhrSensorChannelAdaptor(sc);
+        return sc;
+    }
+
+    BasalRhr basalrhr() const { return BasalRhr(previousValue_); }
+
+public Q_SLOTS:
+    bool start();
+    bool stop();
+
+Q_SIGNALS:
+    void basalrhrChanged(const BasalRhr& value);
+
+protected:
+    BasalRhrSensorChannel(const QString& id);
+    virtual ~BasalRhrSensorChannel();
+
+private:
+    BasalRhrData previousValue_;
+    Bin* filterBin_;
+    Bin* marshallingBin_;
+    DeviceAdaptor* adaptor_;
+    BufferReader<BasalRhrData>* reader_;
+    RingBuffer<BasalRhrData>* outputBuffer_;
+    void emitData(const BasalRhrData& value);
+};
+
+#endif
