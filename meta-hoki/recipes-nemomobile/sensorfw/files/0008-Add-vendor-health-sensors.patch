+    Q_PROPERTY(int status READ status)
+
+public:
+    DailyRhr() {}
+    DailyRhr(const DailyRhrData& data) : QObject(), data_(data.timestamp_, data.value_, data.status_) {}
+    DailyRhr(const DailyRhr& other) : QObject(), data_(other.data_.timestamp_, other.data_.value_, other.data_.status_) {}
+
+    const DailyRhrData& dailyrhrData() const { return data_; }
+    float value() const { return data_.value_; }
+    int status() const { return data_.status_; }
