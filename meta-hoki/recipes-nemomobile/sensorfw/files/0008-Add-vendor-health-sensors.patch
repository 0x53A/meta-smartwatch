+#include "rawppgsensor.h"
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "logging.h"
+
+RawPpgSensorChannel::RawPpgSensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<RawPpgData>(1),
+        previousValue_(0, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+    adaptor_ = sm.requestDeviceAdaptor("rawppgadaptor");
+    if (!adaptor_) { setValid(false); return; }
+
+    reader_ = new BufferReader<RawPpgData>(1);
+    outputBuffer_ = new RingBuffer<RawPpgData>(1);
+
+    filterBin_ = new Bin;
+    filterBin_->add(reader_, "rawppg");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("rawppg", "source", "buffer", "sink");
+    connectToSource(adaptor_, "rawppg", reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+    outputBuffer_->join(this);
+
+    setDescription("Raw PPG waveform sensor");
+    setRangeSource(adaptor_);
+    addStandbyOverrideSource(adaptor_);
+    setIntervalSource(adaptor_);
+    setValid(true);
+}
+
+RawPpgSensorChannel::~RawPpgSensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+        disconnectFromSource(adaptor_, "rawppg", reader_);
+        sm.releaseDeviceAdaptor("rawppgadaptor");
+        delete reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool RawPpgSensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting RawPpgSensorChannel";
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool RawPpgSensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping RawPpgSensorChannel";
+    if (AbstractSensorChannel::stop()) {
+        adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void RawPpgSensorChannel::emitData(const RawPpgData& value)
+{
+    if (value.value_ != previousValue_.value_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
