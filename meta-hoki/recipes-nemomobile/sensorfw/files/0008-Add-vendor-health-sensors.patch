@@ -0,0 +1,78 @@
+#include "dailyrhrsensor.h"
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "logging.h"
+
+DailyRhrSensorChannel::DailyRhrSensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<DailyRhrData>(1),
+        previousValue_(0, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+    adaptor_ = sm.requestDeviceAdaptor("dailyrhradaptor");
+    if (!adaptor_) { setValid(false); return; }
+
+    reader_ = new BufferReader<DailyRhrData>(1);
+    outputBuffer_ = new RingBuffer<DailyRhrData>(1);
+
+    filterBin_ = new Bin;
+    filterBin_->add(reader_, "dailyrhr");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("dailyrhr", "source", "buffer", "sink");
+    connectToSource(adaptor_, "dailyrhr", reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+    outputBuffer_->join(this);
+
+    setDescription("Daily resting heart rate sensor");
+    setRangeSource(adaptor_);
+    addStandbyOverrideSource(adaptor_);
+    setIntervalSource(adaptor_);
+    setValid(true);
+}
+
+DailyRhrSensorChannel::~DailyRhrSensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+        disconnectFromSource(adaptor_, "dailyrhr", reader_);
+        sm.releaseDeviceAdaptor("dailyrhradaptor");
+        delete reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool DailyRhrSensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting DailyRhrSensorChannel";
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool DailyRhrSensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping DailyRhrSensorChannel";
+    if (AbstractSensorChannel::stop()) {
+        adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void DailyRhrSensorChannel::emitData(const DailyRhrData& value)
+{
+    if (value.value_ != previousValue_.value_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
