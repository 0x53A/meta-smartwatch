diff --git a/datatypes/rawppg.h b/datatypes/rawppg.h
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/datatypes/rawppg.h
@@ -0,0 +1,54 @@
+#ifndef RAWPPG_H
+#define RAWPPG_H
+
+#include <QDBusArgument>
+#include <datatypes/rawppgdata.h>
+
+class RawPpg : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(float value READ value)
+    Q_PROPERTY(int status READ status)
+
+public:
+    RawPpg() {}
+    RawPpg(const RawPpgData& data) : QObject(), data_(data.timestamp_, data.value_, data.status_) {}
+    RawPpg(const RawPpg& other) : QObject(), data_(other.data_.timestamp_, other.data_.value_, other.data_.status_) {}
+
+    const RawPpgData& rawppgData() const { return data_; }
+    float value() const { return data_.value_; }
+    int status() const { return data_.status_; }
+
+    RawPpg& operator=(const RawPpg& origin)
+    {
+        data_ = origin.rawppgData();
+        return *this;
+    }
+
+private:
+    RawPpgData data_;
+    friend const QDBusArgument &operator>>(const QDBusArgument &argument, RawPpg& obj);
+};
+
+Q_DECLARE_METATYPE(RawPpg)
+
+inline QDBusArgument &operator<<(QDBusArgument &argument, const RawPpg &obj)
+{
+    argument.beginStructure();
+    argument << obj.rawppgData().value_ << obj.rawppgData().status_;
+    argument.endStructure();
+    return argument;
+}
+
+inline const QDBusArgument &operator>>(const QDBusArgument &argument, RawPpg &obj)
+{
+    double value; int status;
+    argument.beginStructure();
+    argument >> value >> status;
+    argument.endStructure();
+    obj.data_.value_ = value;
+    obj.data_.status_ = status;
+    return argument;
+}
+
+#endif // RAWPPG_H
