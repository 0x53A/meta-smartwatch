+
+#include "hybrisrawppgadaptor.h"
+#include "logging.h"
+#include "datatypes/utils.h"
+
+#define SENSOR_TYPE_RAWPPG 65572
+
+HybrisRawPpgAdaptor::HybrisRawPpgAdaptor(const QString& id) :
+    HybrisAdaptor(id, SENSOR_TYPE_RAWPPG)
+{
+    buffer = new DeviceAdaptorRingBuffer<RawPpgData>(1);
+    setAdaptedSensor("rawppg", "Raw PPG waveform", buffer);
+    setDescription("Hybris Raw PPG waveform sensor");
+    setInterval(0, 1000000);
+}
+
+HybrisRawPpgAdaptor::~HybrisRawPpgAdaptor() { delete buffer; }
+
+bool HybrisRawPpgAdaptor::startSensor()
+{
+    if (!(HybrisAdaptor::startSensor())) return false;
+    qCDebug(lcSensorFw) << "HybrisRawPpgAdaptor started";
+    return true;
+}
+
+void HybrisRawPpgAdaptor::sendInitialData()
+{
+    qCWarning(lcSensorFw) << "No initial data for Raw PPG waveform sensor";
+}
+
+void HybrisRawPpgAdaptor::stopSensor()
+{
+    HybrisAdaptor::stopSensor();
+    qCDebug(lcSensorFw) << "HybrisRawPpgAdaptor stopped";
+}
+
+void HybrisRawPpgAdaptor::processSample(const sensors_event_t& data)
+{
+    qCWarning(lcSensorFw) << "RAWPPG RAW EVENT: type=" << data.type
+                  << " sensor=" << data.sensor
+                  << " timestamp=" << data.timestamp;
+    qCWarning(lcSensorFw) << "  data[0]=" << data.u.data[0]
+                  << " data[1]=" << data.u.data[1]
+                  << " data[2]=" << data.u.data[2]
+                  << " data[3]=" << data.u.data[3]
+                  << " data[4]=" << data.u.data[4]
+                  << " data[5]=" << data.u.data[5];
+
+    RawPpgData *d = buffer->nextSlot();
+    d->timestamp_ = quint64(data.timestamp * .001);
+    d->value_ = data.u.data[0];
+    d->status_ = (int)data.u.data[1];
+    buffer->commit();
+    buffer->wakeUpReaders();
+}
