+
+#define SENSOR_TYPE_WRISTTEMP 65575
+
+HybrisWristTempAdaptor::HybrisWristTempAdaptor(const QString& id) :
+    HybrisAdaptor(id, SENSOR_TYPE_WRISTTEMP)
+{
+    buffer = new DeviceAdaptorRingBuffer<WristTempData>(1);
+    setAdaptedSensor("wristtemp", "On-wrist temperature", buffer);
+    setDescription("Hybris On-wrist temperature sensor");
+    setInterval(0, 1000000);
+}
+
+HybrisWristTempAdaptor::~HybrisWristTempAdaptor() { delete buffer; }
+
+bool HybrisWristTempAdaptor::startSensor()
+{
+    if (!(HybrisAdaptor::startSensor())) return false;
+    qCDebug(lcSensorFw) << "HybrisWristTempAdaptor started";
+    return true;
+}
+
+void HybrisWristTempAdaptor::sendInitialData()
+{
+    qCWarning(lcSensorFw) << "No initial data for On-wrist temperature sensor";
+}
+
+void HybrisWristTempAdaptor::stopSensor()
+{
+    HybrisAdaptor::stopSensor();
+    qCDebug(lcSensorFw) << "HybrisWristTempAdaptor stopped";
+}
+
+void HybrisWristTempAdaptor::processSample(const sensors_event_t& data)
+{
+    qCWarning(lcSensorFw) << "WRISTTEMP RAW EVENT: type=" << data.type
+                  << " sensor=" << data.sensor
+                  << " timestamp=" << data.timestamp;
+    qCWarning(lcSensorFw) << "  data[0]=" << data.u.data[0]
+                  << " data[1]=" << data.u.data[1]
+                  << " data[2]=" << data.u.data[2]
+                  << " data[3]=" << data.u.data[3]
+                  << " data[4]=" << data.u.data[4]
+                  << " data[5]=" << data.u.data[5];
+
+    WristTempData *d = buffer->nextSlot();
+    d->timestamp_ = quint64(data.timestamp * .001);
+    d->value_ = data.u.data[0];
+    d->status_ = (int)data.u.data[1];
+    buffer->commit();
+    buffer->wakeUpReaders();
+}
