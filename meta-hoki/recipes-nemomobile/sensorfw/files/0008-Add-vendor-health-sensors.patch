+#ifndef RRSENSOR_CHANNEL_H
+#define RRSENSOR_CHANNEL_H
+
+#include <QObject>
+#include "deviceadaptor.h"
+#include "abstractsensor.h"
+#include "rrsensor_a.h"
+#include "dataemitter.h"
+#include "datatypes/rrdata.h"
+#include "datatypes/rr.h"
+
+class Bin;
+template <class TYPE> class BufferReader;
+
+class RespirationRateSensorChannel :
+        public AbstractSensorChannel,
+        public DataEmitter<RespirationRateData>
+{
+    Q_OBJECT
+    Q_PROPERTY(RespirationRate rr READ rr)
+
+public:
+    static AbstractSensorChannel* factoryMethod(const QString& id)
+    {
+        RespirationRateSensorChannel* sc = new RespirationRateSensorChannel(id);
+        new RespirationRateSensorChannelAdaptor(sc);
+        return sc;
+    }
+
+    RespirationRate rr() const { return RespirationRate(previousValue_); }
+
+public Q_SLOTS:
+    bool start();
+    bool stop();
+
+Q_SIGNALS:
+    void rrChanged(const RespirationRate& value);
+
+protected:
+    RespirationRateSensorChannel(const QString& id);
+    virtual ~RespirationRateSensorChannel();
+
+private:
+    RespirationRateData previousValue_;
+    Bin* filterBin_;
+    Bin* marshallingBin_;
+    DeviceAdaptor* adaptor_;
+    BufferReader<RespirationRateData>* reader_;
+    RingBuffer<RespirationRateData>* outputBuffer_;
+    void emitData(const RespirationRateData& value);
+};
+
+#endif
