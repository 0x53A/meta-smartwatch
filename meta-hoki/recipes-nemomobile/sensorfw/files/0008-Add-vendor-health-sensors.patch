diff --git a/datatypes/rrdata.h b/datatypes/rrdata.h
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/datatypes/rrdata.h
@@ -0,0 +1,16 @@
+#ifndef RRDATA_H
+#define RRDATA_H
+
+#include "datatypes/genericdata.h"
+
+class RespirationRateData : public TimedData {
+public:
+    RespirationRateData() : TimedData(0), value_(0), status_(0) {}
+    RespirationRateData(const quint64& timestamp, float value, int status)
+        : TimedData(timestamp), value_(value), status_(status) {}
+
+    float value_;   // breaths per minute
+    int status_;    // accuracy/confidence
+};
+
+#endif // RRDATA_H
diff --git a/datatypes/rr.h b/datatypes/rr.h
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/datatypes/rr.h
@@ -0,0 +1,54 @@
+#ifndef RR_H
+#define RR_H
+
+#include <QDBusArgument>
+#include <datatypes/rrdata.h>
+
+class RespirationRate : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(float value READ value)
+    Q_PROPERTY(int status READ status)
+
+public:
+    RespirationRate() {}
+    RespirationRate(const RespirationRateData& data) : QObject(), data_(data.timestamp_, data.value_, data.status_) {}
+    RespirationRate(const RespirationRate& other) : QObject(), data_(other.data_.timestamp_, other.data_.value_, other.data_.status_) {}
+
+    const RespirationRateData& rrData() const { return data_; }
+    float value() const { return data_.value_; }
+    int status() const { return data_.status_; }
+
+    RespirationRate& operator=(const RespirationRate& origin)
+    {
+        data_ = origin.rrData();
+        return *this;
+    }
+
+private:
+    RespirationRateData data_;
+    friend const QDBusArgument &operator>>(const QDBusArgument &argument, RespirationRate& obj);
+};
+
+Q_DECLARE_METATYPE(RespirationRate)
+
+inline QDBusArgument &operator<<(QDBusArgument &argument, const RespirationRate &obj)
+{
+    argument.beginStructure();
+    argument << obj.rrData().value_ << obj.rrData().status_;
+    argument.endStructure();
+    return argument;
+}
+
+inline const QDBusArgument &operator>>(const QDBusArgument &argument, RespirationRate &obj)
+{
+    double value; int status;
+    argument.beginStructure();
+    argument >> value >> status;
+    argument.endStructure();
+    obj.data_.value_ = value;
+    obj.data_.status_ = status;
+    return argument;
+}
+
+#endif // RR_H
