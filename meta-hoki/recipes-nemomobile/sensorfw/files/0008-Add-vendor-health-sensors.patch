diff --git a/sensors/basalrhrsensor/basalrhrsensor.cpp b/sensors/basalrhrsensor/basalrhrsensor.cpp
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/sensors/basalrhrsensor/basalrhrsensor.cpp
@@ -0,0 +1,78 @@
+#include "basalrhrsensor.h"
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "logging.h"
+
+BasalRhrSensorChannel::BasalRhrSensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<BasalRhrData>(1),
+        previousValue_(0, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+    adaptor_ = sm.requestDeviceAdaptor("basalrhradaptor");
+    if (!adaptor_) { setValid(false); return; }
+
+    reader_ = new BufferReader<BasalRhrData>(1);
+    outputBuffer_ = new RingBuffer<BasalRhrData>(1);
+
+    filterBin_ = new Bin;
+    filterBin_->add(reader_, "basalrhr");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("basalrhr", "source", "buffer", "sink");
+    connectToSource(adaptor_, "basalrhr", reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+    outputBuffer_->join(this);
+
+    setDescription("Basal resting heart rate sensor");
+    setRangeSource(adaptor_);
+    addStandbyOverrideSource(adaptor_);
+    setIntervalSource(adaptor_);
+    setValid(true);
+}
+
+BasalRhrSensorChannel::~BasalRhrSensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+        disconnectFromSource(adaptor_, "basalrhr", reader_);
+        sm.releaseDeviceAdaptor("basalrhradaptor");
+        delete reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool BasalRhrSensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting BasalRhrSensorChannel";
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool BasalRhrSensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping BasalRhrSensorChannel";
+    if (AbstractSensorChannel::stop()) {
+        adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void BasalRhrSensorChannel::emitData(const BasalRhrData& value)
+{
+    if (value.value_ != previousValue_.value_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
