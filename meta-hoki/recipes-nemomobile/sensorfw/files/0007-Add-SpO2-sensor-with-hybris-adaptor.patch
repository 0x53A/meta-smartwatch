diff --git a/datatypes/spo2.h b/datatypes/spo2.h
new file mode 100644
index 0000000..8a278ba
--- /dev/null
+++ b/datatypes/spo2.h
@@ -0,0 +1,90 @@
+/**
+   @file spo2.h
+   @brief QObject based datatype for Spo2Data
+
+   <p>
+   Copyright (C) 2026 Lukas Rieger
+
+   This file is part of Sensord.
+
+   Sensord is free software; you can redistribute it and/or modify
+   it under the terms of the GNU Lesser General Public License
+   version 2.1 as published by the Free Software Foundation.
+
+   Sensord is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with Sensord.  If not, see <http://www.gnu.org/licenses/>.
+   </p>
+ */
+
+#ifndef SPO2_H
+#define SPO2_H
+
+#include <QDBusArgument>
+#include <datatypes/spo2data.h>
+
+/**
+ * QObject facade for #Spo2Data.
+ */
+class Spo2 : public QObject
+{
+    Q_OBJECT
+
+    Q_PROPERTY(Spo2Status spo2Status READ status)
+    Q_PROPERTY(int percentage READ percentage)
+    Q_PROPERTY(int confidence READ confidence)
+
+public:
+    Spo2() {}
+
+    Spo2(const Spo2Data& spo2Data);
+
+    Spo2(const Spo2& spo2);
+
+    const Spo2Data& spo2Data() const { return data_; }
+
+    Spo2Status status() const { return data_.status_; }
+
+    int percentage() const { return data_.percentage_; }
+
+    int confidence() const { return data_.confidence_; }
+
+    Spo2& operator=(const Spo2& origin)
+    {
+        data_ = origin.spo2Data();
+        return *this;
+    }
+
+private:
+    Spo2Data data_;
+
+    friend const QDBusArgument &operator>>(const QDBusArgument &argument, Spo2& spo2);
+};
+
+Q_DECLARE_METATYPE(Spo2)
+
+inline QDBusArgument &operator<<(QDBusArgument &argument, const Spo2 &spo2)
+{
+    argument.beginStructure();
+    argument << spo2.spo2Data().status_ << spo2.spo2Data().percentage_ << spo2.spo2Data().confidence_;
+    argument.endStructure();
+    return argument;
+}
+
+inline const QDBusArgument &operator>>(const QDBusArgument &argument, Spo2 &spo2)
+{
+    int status, percentage, confidence;
+    argument.beginStructure();
+    argument >> status >> percentage >> confidence;
+    argument.endStructure();
+    spo2.data_.status_ = (Spo2Status)status;
+    spo2.data_.percentage_ = percentage;
+    spo2.data_.confidence_ = confidence;
+    return argument;
+}
+
+#endif // SPO2_H
