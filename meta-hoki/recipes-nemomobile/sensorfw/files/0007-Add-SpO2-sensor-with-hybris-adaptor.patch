+** packaging of this file.  Please review the following information to
+** ensure the GNU Lesser General Public License version 2.1 requirements
+** will be met: http://www.gnu.org/licenses/old-licenses/lgpl-2.1.html.
+**
+** $QT_END_LICENSE$
+**
+****************************************************************************/
+
+#include "hybrisspo2adaptor.h"
+#include "logging.h"
+#include "datatypes/utils.h"
+#include "config.h"
+
+// LifeQ SpO2 vendor sensor type: SENSOR_TYPE_DEVICE_PRIVATE_BASE + 25
+#define SENSOR_TYPE_SPO2 65561
+
+HybrisSpo2Adaptor::HybrisSpo2Adaptor(const QString& id) :
+    HybrisAdaptor(id, SENSOR_TYPE_SPO2)
+{
+    buffer = new DeviceAdaptorRingBuffer<Spo2Data>(1);
+    setAdaptedSensor("spo2", "Blood oxygen saturation", buffer);
+    setDescription("Hybris SpO2 sensor (LifeQ)");
+    // SpO2 measurements are slow (30+ seconds), use 1s polling interval
+    unsigned int interval_us = 1000 * 1000;
+    setInterval(0, interval_us);
+}
+
+HybrisSpo2Adaptor::~HybrisSpo2Adaptor()
+{
+    delete buffer;
+}
+
+bool HybrisSpo2Adaptor::startSensor()
+{
+    if (!(HybrisAdaptor::startSensor()))
+        return false;
+    qCDebug(lcSensorFw) << "HybrisSpo2Adaptor started";
+    return true;
+}
+
+void HybrisSpo2Adaptor::sendInitialData()
+{
+    qCWarning(lcSensorFw) << "No initial data for SpO2 sensor";
+}
+
+void HybrisSpo2Adaptor::stopSensor()
+{
+    HybrisAdaptor::stopSensor();
+    qCDebug(lcSensorFw) << "HybrisSpo2Adaptor stopped";
+}
+
+void HybrisSpo2Adaptor::processSample(const sensors_event_t& data)
+{
+    // DEBUG: Dump all float data fields to discover the vendor event format.
+    // The LifeQ SpO2 vendor sensor (type 65561) uses the generic data[16] union.
+    // Once we know the layout, we can remove this debug logging.
+    qCWarning(lcSensorFw) << "SPO2 RAW EVENT: type=" << data.type
+                  << " sensor=" << data.sensor
+                  << " timestamp=" << data.timestamp;
+    qCWarning(lcSensorFw) << "  data[0]=" << data.u.data[0]
+                  << " data[1]=" << data.u.data[1]
+                  << " data[2]=" << data.u.data[2]
+                  << " data[3]=" << data.u.data[3];
+    qCWarning(lcSensorFw) << "  data[4]=" << data.u.data[4]
+                  << " data[5]=" << data.u.data[5]
+                  << " data[6]=" << data.u.data[6]
+                  << " data[7]=" << data.u.data[7];
+    qCWarning(lcSensorFw) << "  data[8]=" << data.u.data[8]
+                  << " data[9]=" << data.u.data[9]
+                  << " data[10]=" << data.u.data[10]
+                  << " data[11]=" << data.u.data[11];
+    qCWarning(lcSensorFw) << "  data[12]=" << data.u.data[12]
+                  << " data[13]=" << data.u.data[13]
+                  << " data[14]=" << data.u.data[14]
+                  << " data[15]=" << data.u.data[15];
+
+    Spo2Data *d = buffer->nextSlot();
+    d->timestamp_ = quint64(data.timestamp * .001);
+
+    // Preliminary field mapping -- will be refined after observing real data.
+    // Assumption: data[0] = SpO2 percentage, data[1] = confidence or status.
+    d->percentage_ = (int)data.u.data[0];
+    d->confidence_ = (int)data.u.data[1];
+
+    // Map status from generic accuracy values
+    int8_t raw_status = (int8_t)data.u.data[2];
+    switch(raw_status) {
+    case 0:
+        d->status_ = Spo2Unreliable;
+        break;
+    case 1:
+        d->status_ = Spo2AccuracyLow;
+        break;
+    case 2:
+        d->status_ = Spo2AccuracyMedium;
+        break;
+    case 3:
+        d->status_ = Spo2AccuracyHigh;
+        break;
+    default:
+        d->status_ = Spo2NoContact;
+    }
+
+    buffer->commit();
+    buffer->wakeUpReaders();
+}
