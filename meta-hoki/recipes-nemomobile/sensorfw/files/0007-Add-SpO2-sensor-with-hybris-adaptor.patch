+#ifndef HYBRISSPO2ADAPTOR_H
+#define HYBRISSPO2ADAPTOR_H
+#include "hybrisadaptor.h"
+
+#include <QString>
+#include <QStringList>
+#include <linux/input.h>
+#include "deviceadaptorringbuffer.h"
+#include "datatypes/spo2data.h"
+#include <QTime>
+
+/**
+ * @brief Adaptor for hybris SpO2 sensor.
+ *
+ * Adaptor for blood oxygen saturation sensor (LifeQ SpO2).
+ * Vendor sensor type 65561 (SENSOR_TYPE_DEVICE_PRIVATE_BASE + 25).
+ *
+ * Returns SpO2 percentage and confidence level.
+ */
+class HybrisSpo2Adaptor : public HybrisAdaptor
+{
+    Q_OBJECT
+
+public:
+    static DeviceAdaptor* factoryMethod(const QString& id) {
+        return new HybrisSpo2Adaptor(id);
+    }
+    HybrisSpo2Adaptor(const QString& id);
+    ~HybrisSpo2Adaptor();
+
+    bool startSensor();
+    void stopSensor();
+
+    void sendInitialData();
+
+protected:
+    void processSample(const sensors_event_t& data);
+
+private:
+    DeviceAdaptorRingBuffer<Spo2Data>* buffer;
+
+};
+#endif
