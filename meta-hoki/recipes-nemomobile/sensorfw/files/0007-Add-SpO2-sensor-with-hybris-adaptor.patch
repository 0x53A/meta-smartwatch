                  hybrisgeorotationadaptor \
                  hybrisstepcounteradaptor \
                  hybrishrmadaptor \
-                 hybriswristgestureadaptor
+                 hybriswristgestureadaptor \
+                 hybrisspo2adaptor
 
 # split like this as Sailfish only installs hybris plugins
