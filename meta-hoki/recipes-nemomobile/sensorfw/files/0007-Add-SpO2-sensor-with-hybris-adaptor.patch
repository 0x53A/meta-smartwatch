+#ifndef SPO2SENSOR_CHANNEL_H
+#define SPO2SENSOR_CHANNEL_H
+
+#include <QObject>
+
+#include "deviceadaptor.h"
+#include "abstractsensor.h"
+#include "spo2sensor_a.h"
+#include "dataemitter.h"
+#include "datatypes/spo2data.h"
+#include "datatypes/spo2.h"
+
+class Bin;
+template <class TYPE> class BufferReader;
+
+/**
+ * @brief SpO2 sensor channel.
+ *
+ * Provides blood oxygen saturation data from the hybris HAL adaptor.
+ */
+class Spo2SensorChannel :
+        public AbstractSensorChannel,
+        public DataEmitter<Spo2Data>
+{
+    Q_OBJECT
+    Q_PROPERTY(Spo2 spo2 READ spo2)
+
+public:
+    static AbstractSensorChannel* factoryMethod(const QString& id)
+    {
+        Spo2SensorChannel* sc = new Spo2SensorChannel(id);
+        new Spo2SensorChannelAdaptor(sc);
+        return sc;
+    }
+
+    Spo2 spo2() const { return Spo2(previousValue_); }
+
+public Q_SLOTS:
+    bool start();
+    bool stop();
+
+Q_SIGNALS:
+    void spo2Changed(const Spo2& value);
+
+protected:
+    Spo2SensorChannel(const QString& id);
+    virtual ~Spo2SensorChannel();
+
+private:
+    Spo2Data previousValue_;
+    Bin*                          filterBin_;
+    Bin*                          marshallingBin_;
+    DeviceAdaptor*                spo2Adaptor_;
+    BufferReader<Spo2Data>*       spo2Reader_;
+    RingBuffer<Spo2Data>*         outputBuffer_;
+
+    void emitData(const Spo2Data& value);
+};
+
+#endif // SPO2SENSOR_CHANNEL_H
