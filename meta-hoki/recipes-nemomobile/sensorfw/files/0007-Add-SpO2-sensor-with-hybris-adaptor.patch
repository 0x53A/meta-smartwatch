+
+#include "spo2sensor.h"
+
+#include "sensormanager.h"
+#include "bin.h"
+#include "bufferreader.h"
+#include "datatypes/spo2data.h"
+#include "logging.h"
+
+Spo2SensorChannel::Spo2SensorChannel(const QString& id) :
+        AbstractSensorChannel(id),
+        DataEmitter<Spo2Data>(1),
+        previousValue_(0, Spo2NoContact, 0, 0)
+{
+    SensorManager& sm = SensorManager::instance();
+
+    spo2Adaptor_ = sm.requestDeviceAdaptor("spo2adaptor");
+    if (!spo2Adaptor_) {
+        setValid(false);
+        return;
+    }
+
+    spo2Reader_ = new BufferReader<Spo2Data>(1);
+
+    outputBuffer_ = new RingBuffer<Spo2Data>(1);
+
+    // Create brains for the chain
+    filterBin_ = new Bin;
+    filterBin_->add(spo2Reader_, "spo2");
+    filterBin_->add(outputBuffer_, "buffer");
+    filterBin_->join("spo2", "source", "buffer", "sink");
+
+    // Join brains
+    connectToSource(spo2Adaptor_, "spo2", spo2Reader_);
+
+    marshallingBin_ = new Bin;
+    marshallingBin_->add(this, "sensorchannel");
+
+    outputBuffer_->join(this);
+
+    setDescription("SpO2 blood oxygen saturation sensor");
+    setRangeSource(spo2Adaptor_);
+    addStandbyOverrideSource(spo2Adaptor_);
+    setIntervalSource(spo2Adaptor_);
+
+    setValid(true);
+}
+
+Spo2SensorChannel::~Spo2SensorChannel()
+{
+    if (isValid()) {
+        SensorManager& sm = SensorManager::instance();
+
+        disconnectFromSource(spo2Adaptor_, "spo2", spo2Reader_);
+
+        sm.releaseDeviceAdaptor("spo2adaptor");
+
+        delete spo2Reader_;
+        delete outputBuffer_;
+        delete marshallingBin_;
+        delete filterBin_;
+    }
+}
+
+bool Spo2SensorChannel::start()
+{
+    qCDebug(lcSensorFw) << "Starting Spo2SensorChannel";
+
+    if (AbstractSensorChannel::start()) {
+        marshallingBin_->start();
+        filterBin_->start();
+        spo2Adaptor_->startSensor();
+    }
+    return true;
+}
+
+bool Spo2SensorChannel::stop()
+{
+    qCDebug(lcSensorFw) << "Stopping Spo2SensorChannel";
+
+    if (AbstractSensorChannel::stop()) {
+        spo2Adaptor_->stopSensor();
+        filterBin_->stop();
+        marshallingBin_->stop();
+    }
+    return true;
+}
+
+void Spo2SensorChannel::emitData(const Spo2Data& value)
+{
+    if (value.percentage_ != previousValue_.percentage_ ||
+        value.confidence_ != previousValue_.confidence_ ||
+        value.status_ != previousValue_.status_) {
+        previousValue_ = value;
+        writeToClients((const void*)(&value), sizeof(value));
+    }
+}
