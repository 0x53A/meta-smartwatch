From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukas Rieger <lukas@0x53a.dev>
Date: Fri, 21 Mar 2026 00:00:00 +0100
Subject: [PATCH] rtc: qpnp: Sysfs-gated set_time with diagnostic logging

On the Fossil Gen 6 (hoki), SPMI writes to the PM660 RTC peripheral
(base 0x6000) cause a crash/reboot. Add a sysfs gate (rtc_write_armed,
default 0) so that dsme's automatic RTC_SET_TIME at boot is no-oped.

To test manually after boot:
  echo 1 > /sys/.../rtc_write_armed
  hwclock --systohc
  dmesg | grep qpnp-rtc

Each SPMI write in set_time is logged with pr_err for diagnosis.

Upstream-Status: Inappropriate [temporary debug patch]
Signed-off-by: Lukas Rieger <lukas@0x53a.dev>
---
 drivers/rtc/qpnp-rtc.c | 76 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)

--- a/drivers/rtc/qpnp-rtc.c
+++ b/drivers/rtc/qpnp-rtc.c
@@ -59,6 +59,7 @@
 /* rtc driver internal structure */
 struct qpnp_rtc {
 	u8			rtc_ctrl_reg;
+	u8			write_armed;
 	u8			alarm_ctrl_reg1;
 	u16			rtc_base;
 	u16			alarm_base;
@@ -72,6 +73,31 @@
 	spinlock_t		alarm_ctrl_lock;
 };
 
+static ssize_t rtc_write_armed_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct qpnp_rtc *rtc_dd = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%u\n", rtc_dd->write_armed);
+}
+
+static ssize_t rtc_write_armed_store(struct device *dev,
+				     struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	struct qpnp_rtc *rtc_dd = dev_get_drvdata(dev);
+	unsigned int val;
+
+	if (kstrtouint(buf, 0, &val) || val > 1)
+		return -EINVAL;
+
+	rtc_dd->write_armed = val;
+	pr_err("qpnp-rtc: write_armed set to %u\n", val);
+	return count;
+}
+
+static DEVICE_ATTR_RW(rtc_write_armed);
+
 static int qpnp_sec_access(struct qpnp_rtc *rtc_dd, u16 base)
 {
 	u8 sec_val = SEC_ACCESS_VALUE;
@@ -118,6 +144,14 @@
 
 	rtc_tm_to_time(tm, &secs);
 
+	pr_err("qpnp-rtc: set_time called, secs=%lu, armed=%u\n",
+	       secs, rtc_dd->write_armed);
+
+	if (!rtc_dd->write_armed) {
+		pr_err("qpnp-rtc: set_time SKIPPED (not armed)\n");
+		return 0;
+	}
+
 	value[0] = secs & 0xFF;
 	value[1] = (secs >> 8) & 0xFF;
 	value[2] = (secs >> 16) & 0xFF;
@@ -170,6 +204,8 @@
 	if (rtc_ctrl_reg & BIT_RTC_ENABLE) {
 		rtc_disabled = 1;
 		rtc_ctrl_reg &= ~BIT_RTC_ENABLE;
+		pr_err("qpnp-rtc: WRITE CTRL (0x%04x) = 0x%02x [disable RTC]\n",
+		       rtc_dd->rtc_base + REG_OFFSET_RTC_CTRL, rtc_ctrl_reg);
 		qpnp_sec_access(rtc_dd, rtc_dd->rtc_base);
 		rc = qpnp_write_wrapper(rtc_dd, &rtc_ctrl_reg,
 				rtc_dd->rtc_base + REG_OFFSET_RTC_CTRL, 1);
@@ -178,11 +214,14 @@
 				rc);
 			goto rtc_rw_fail;
 		}
+		pr_err("qpnp-rtc: WRITE CTRL disable OK\n");
 		rtc_dd->rtc_ctrl_reg = rtc_ctrl_reg;
 	}
 
 	/* Clear WDATA[0] */
 	reg = 0x0;
+	pr_err("qpnp-rtc: WRITE WDATA[0] (0x%04x) = 0x00 [clear]\n",
+	       rtc_dd->rtc_base + REG_OFFSET_RTC_WRITE);
 	qpnp_sec_access(rtc_dd, rtc_dd->rtc_base);
 	rc = qpnp_write_wrapper(rtc_dd, &reg,
 				rtc_dd->rtc_base + REG_OFFSET_RTC_WRITE, 1);
@@ -190,8 +229,12 @@
 		dev_err(dev, "Write to RTC reg failed\n");
 		goto rtc_rw_fail;
 	}
+	pr_err("qpnp-rtc: WRITE WDATA[0] clear OK\n");
 
 	/* Write to WDATA[3], WDATA[2] and WDATA[1] */
+	pr_err("qpnp-rtc: WRITE WDATA[1..3] (0x%04x) = %02x %02x %02x\n",
+	       rtc_dd->rtc_base + REG_OFFSET_RTC_WRITE + 1,
+	       value[1], value[2], value[3]);
 	qpnp_sec_access(rtc_dd, rtc_dd->rtc_base);
 	rc = qpnp_write_wrapper(rtc_dd, &value[1],
 			rtc_dd->rtc_base + REG_OFFSET_RTC_WRITE + 1, 3);
@@ -199,8 +242,11 @@
 		dev_err(dev, "Write to RTC reg failed\n");
 		goto rtc_rw_fail;
 	}
+	pr_err("qpnp-rtc: WRITE WDATA[1..3] OK\n");
 
 	/* Write to WDATA[0] */
+	pr_err("qpnp-rtc: WRITE WDATA[0] (0x%04x) = 0x%02x [final]\n",
+	       rtc_dd->rtc_base + REG_OFFSET_RTC_WRITE, value[0]);
 	qpnp_sec_access(rtc_dd, rtc_dd->rtc_base);
 	rc = qpnp_write_wrapper(rtc_dd, value,
 				rtc_dd->rtc_base + REG_OFFSET_RTC_WRITE, 1);
@@ -208,10 +254,13 @@
 		dev_err(dev, "Write to RTC reg failed\n");
 		goto rtc_rw_fail;
 	}
+	pr_err("qpnp-rtc: WRITE WDATA[0] final OK\n");
 
 	/* Enable RTC H/w after writing on RTC register*/
 	if (rtc_disabled) {
 		rtc_ctrl_reg |= BIT_RTC_ENABLE;
+		pr_err("qpnp-rtc: WRITE CTRL (0x%04x) = 0x%02x [re-enable]\n",
+		       rtc_dd->rtc_base + REG_OFFSET_RTC_CTRL, rtc_ctrl_reg);
 		qpnp_sec_access(rtc_dd, rtc_dd->rtc_base);
 		rc = qpnp_write_wrapper(rtc_dd, &rtc_ctrl_reg,
 				rtc_dd->rtc_base + REG_OFFSET_RTC_CTRL, 1);
@@ -220,9 +269,12 @@
 				rc);
 			goto rtc_rw_fail;
 		}
+		pr_err("qpnp-rtc: WRITE CTRL re-enable OK\n");
 		rtc_dd->rtc_ctrl_reg = rtc_ctrl_reg;
 	}
 
+	pr_err("qpnp-rtc: set_time COMPLETE, rc=0\n");
+
 	if (alarm_enabled) {
 		ctrl_reg |= BIT_RTC_ALARM_ENABLE;
 		qpnp_sec_access(rtc_dd, rtc_dd->alarm_base);
@@ -613,8 +665,23 @@
 	if (rtc_dd->rtc_write_enable == true)
 		rtc_ops = &qpnp_rtc_rw_ops;
 
+	pr_err("qpnp-rtc: probe: rtc_base=0x%04x alarm_base=0x%04x write_enable=%u\n",
+	       rtc_dd->rtc_base, rtc_dd->alarm_base,
+	       rtc_dd->rtc_write_enable);
+
 	dev_set_drvdata(&pdev->dev, rtc_dd);
 
+	if (rtc_dd->rtc_write_enable) {
+		rc = device_create_file(&pdev->dev, &dev_attr_rtc_write_armed);
+		if (rc) {
+			dev_err(&pdev->dev,
+				"Failed to create rtc_write_armed sysfs: %d\n",
+				rc);
+			goto fail_rtc_enable;
+		}
+		pr_err("qpnp-rtc: sysfs rtc_write_armed created (default=0)\n");
+	}
+
 	/* Register the RTC device */
 	rtc_dd->rtc = rtc_device_register("qpnp_rtc", &pdev->dev,
 					  rtc_ops, THIS_MODULE);
