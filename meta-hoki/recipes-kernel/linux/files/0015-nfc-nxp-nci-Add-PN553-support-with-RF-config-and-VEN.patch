Upstream-Status: Pending
Subject: nfc: nxp-nci: Add PN553 support with RF config, VEN timing, legacy DT, and clock management

Adds support for using the mainline nxp-nci driver with the NXP PN553 NFC
controller on Qualcomm MSM8909W platforms (Fossil Gen 6 watches):
- post_setup hook to load vendor RF antenna config from firmware file
- Proprietary NCI response/notification handlers for NXP vendor opcodes
- Increase VEN boot delay to 100ms (PN553 requirement)
- Accept legacy "nxp,pn544" DT compatible and GPIO property names
- Reference clock (BBCLK2) management to prevent clk_disable_unused
- Fix NCI DISCOVER_MAP to include T2T/T3T protocols and use poll-only mode
- NXP proprietary MIFARE Classic protocol support (DISCOVER_MAP + get_rfprotocol)
- Reformat MIFARE auth commands for NXP proprietary interface

diff --git a/drivers/nfc/nxp-nci/core.c b/drivers/nfc/nxp-nci/core.c
index 2e4b004a96aa..cf320508e916 100644
--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -24,9 +24,11 @@
 #include <linux/delay.h>
 #include <linux/gpio.h>
 #include <linux/module.h>
+#include <linux/firmware.h>
 #include <linux/nfc.h>
 #include <linux/platform_data/nxp-nci.h>
 
+#include <net/nfc/nci.h>
 #include <net/nfc/nci_core.h>
 
 #include "nxp-nci.h"
@@ -101,11 +103,119 @@ static int nxp_nci_send(struct nci_dev *ndev, struct sk_buff *skb)
 	return r;
 }
 
+/*
+ * Load NXP vendor RF configuration from firmware file and send each
+ * NCI command to the chip. Called after CORE_INIT, before discovery.
+ *
+ * Firmware file format:
+ *   [2-byte big-endian length][raw NCI command bytes]...
+ *   terminated by [0x0000]
+ */
+/*
+ * Handle NXP proprietary NCI responses. The PN553 responds to standard
+ * CORE_SET_CONFIG with vendor parameters (A0,xx) using proprietary
+ * response opcodes (GID=0xf). Without this handler, the NCI core drops
+ * the response and nci_send_cmd() times out after 5 seconds per command.
+ */
+static int nxp_nci_prop_rsp(struct nci_dev *ndev, struct sk_buff *skb)
+{
+	/* Status byte is first byte of payload */
+	u8 status = skb->data[0];
+
+	nci_req_complete(ndev, status);
+	return 0;
+}
+
+static int nxp_nci_prop_ntf(struct nci_dev *ndev, struct sk_buff *skb)
+{
+	/* Silently consume NXP proprietary notifications */
+	return 0;
+}
+
+/* Register handlers for proprietary opcodes from the NXP PN553.
+ * NXP uses GID=0xf with OID matching the original command's OID. */
+static struct nci_driver_ops nxp_nci_prop_ops[] = {
+	{ .opcode = nci_opcode_pack(NCI_GID_PROPRIETARY, 0x00),
+	  .rsp = nxp_nci_prop_rsp, .ntf = nxp_nci_prop_ntf },
+	{ .opcode = nci_opcode_pack(NCI_GID_PROPRIETARY, 0x02),
+	  .rsp = nxp_nci_prop_rsp, .ntf = nxp_nci_prop_ntf },
+};
+
+/* NXP proprietary NCI protocol/interface IDs for MIFARE Classic */
+#define NXP_NCI_RF_PROTOCOL_MIFARE	0x80
+#define NXP_NCI_RF_INTERFACE_MIFARE	0x80
+
+static __u32 nxp_nci_get_rfprotocol(struct nci_dev *ndev, __u8 rf_protocol)
+{
+	if (rf_protocol == NXP_NCI_RF_PROTOCOL_MIFARE)
+		return NFC_PROTO_MIFARE_MASK;
+	return 0;
+}
+
+static int nxp_nci_post_setup(struct nci_dev *ndev)
+{
+	struct nxp_nci_info *info = nci_get_drvdata(ndev);
+	const struct firmware *fw;
+	const u8 *data;
+	size_t size;
+	int r, count = 0;
+
+	r = request_firmware(&fw, "nxp/nxp-nci-rf-config.bin", info->pdev);
+	if (r < 0) {
+		if (r == -ENOENT)
+			dev_info(info->pdev,
+				 "No RF config (nxp/nxp-nci-rf-config.bin)\n");
+		else
+			dev_warn(info->pdev,
+				 "Failed to load RF config: %d\n", r);
+		return 0;
+	}
+
+	data = fw->data;
+	size = fw->size;
+
+	while (size >= 2) {
+		u16 cmd_len = (data[0] << 8) | data[1];
+		u16 opcode;
+
+		data += 2;
+		size -= 2;
+
+		if (cmd_len == 0)
+			break;
+
+		if (cmd_len < 3 || cmd_len > size) {
+			dev_err(info->pdev,
+				"RF config truncated at cmd %d\n", count);
+			break;
+		}
+
+		opcode = nci_opcode(data);
+
+		r = nci_send_cmd(ndev, opcode, data[2], (void *)(data + 3));
+		if (r < 0)
+			dev_warn(info->pdev,
+				 "RF config cmd %d failed: %d\n", count, r);
+
+		data += cmd_len;
+		size -= cmd_len;
+		count++;
+	}
+
+	dev_info(info->pdev, "Sent %d NXP RF config commands\n", count);
+	release_firmware(fw);
+	return 0;
+}
+
 static struct nci_ops nxp_nci_ops = {
 	.open = nxp_nci_open,
 	.close = nxp_nci_close,
 	.send = nxp_nci_send,
+	.post_setup = nxp_nci_post_setup,
 	.fw_download = nxp_nci_fw_download,
+	.prop_ops = nxp_nci_prop_ops,
+	.n_prop_ops = ARRAY_SIZE(nxp_nci_prop_ops),
+	.get_rfprotocol = nxp_nci_get_rfprotocol,
 };
 
 int nxp_nci_probe(void *phy_id, struct device *pdev,
