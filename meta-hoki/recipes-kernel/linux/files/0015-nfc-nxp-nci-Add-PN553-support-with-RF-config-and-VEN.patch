 	if (mode == NXP_NCI_MODE_COLD)
 		phy->hard_fault = 0;
@@ -273,9 +279,10 @@ static int nxp_nci_i2c_parse_devtree(struct i2c_client *client)
 	if (!pp)
 		return -ENODEV;
 
+	/* Try mainline binding, then legacy NXP binding */
 	r = of_get_named_gpio(pp, "enable-gpios", 0);
-	if (r == -EPROBE_DEFER)
-		r = of_get_named_gpio(pp, "enable-gpios", 0);
+	if (r < 0)
+		r = of_get_named_gpio(pp, "nxp,pn544-ven", 0);
 	if (r < 0) {
 		nfc_err(&client->dev, "Failed to get EN gpio, error: %d\n", r);
 		return r;
@@ -283,8 +290,8 @@ static int nxp_nci_i2c_parse_devtree(struct i2c_client *client)
 	phy->gpio_en = r;
 
 	r = of_get_named_gpio(pp, "firmware-gpios", 0);
-	if (r == -EPROBE_DEFER)
-		r = of_get_named_gpio(pp, "firmware-gpios", 0);
+	if (r < 0)
+		r = of_get_named_gpio(pp, "nxp,pn544-fw-dwnld", 0);
 	if (r < 0) {
 		nfc_err(&client->dev, "Failed to get FW gpio, error: %d\n", r);
 		return r;
@@ -374,6 +381,29 @@ static int nxp_nci_i2c_probe(struct i2c_client *client,
 	if (r < 0)
 		goto probe_exit;
 
+	/* Vote for reference clock so clk_disable_unused() doesn't kill it.
+	 * The PN553 needs BBCLK2 (19.2MHz from PMIC). */
+	phy->ref_clk = devm_clk_get(&client->dev, "ref_clk");
+	if (!IS_ERR(phy->ref_clk)) {
+		r = clk_prepare_enable(phy->ref_clk);
+		if (r)
+			dev_warn(&client->dev, "ref_clk enable failed: %d\n", r);
+		else
+			dev_info(&client->dev, "Enabled ref_clk\n");
+	}
+
+	phy->ref_clk_buf = __clk_lookup("bb_clk2");
+	if (!phy->ref_clk_buf) {
+		dev_warn(&client->dev, "bb_clk2 not found\n");
+	} else {
+		r = clk_prepare_enable(phy->ref_clk_buf);
+		if (r)
+			dev_warn(&client->dev, "bb_clk2 enable failed: %d\n", r);
+		else
+			dev_info(&client->dev, "Enabled bb_clk2 buffer\n");
+		r = 0;
+	}
+
 	r = request_threaded_irq(client->irq, NULL,
 				 nxp_nci_i2c_irq_thread_fn,
 				 IRQF_TRIGGER_RISING | IRQF_ONESHOT,
@@ -403,6 +433,7 @@ MODULE_DEVICE_TABLE(i2c, nxp_nci_i2c_id_table);
 
 static const struct of_device_id of_nxp_nci_i2c_match[] = {
 	{ .compatible = "nxp,nxp-nci-i2c", },
+	{ .compatible = "nxp,pn544", },
 	{},
 };
 MODULE_DEVICE_TABLE(of, of_nxp_nci_i2c_match);
diff --git a/net/nfc/nci/core.c b/net/nfc/nci/core.c
index c25e9b4179c3..c37e73170908 100644
--- a/net/nfc/nci/core.c
+++ b/net/nfc/nci/core.c
@@ -190,20 +190,34 @@ static void nci_init_complete_req(struct nci_dev *ndev, unsigned long opt)
 	/* set rf mapping configurations */
 	*num = 0;
 
-	/* by default mapping is set to NCI_RF_INTERFACE_FRAME */
+	/* Map T2T (MIFARE) and T3T (Felica) to FRAME interface */
+	cfg[*num].rf_protocol = NCI_RF_PROTOCOL_T2T;
+	cfg[*num].mode = NCI_DISC_MAP_MODE_POLL;
+	cfg[*num].rf_interface = NCI_RF_INTERFACE_FRAME;
+	(*num)++;
+
+	cfg[*num].rf_protocol = NCI_RF_PROTOCOL_T3T;
+	cfg[*num].mode = NCI_DISC_MAP_MODE_POLL;
+	cfg[*num].rf_interface = NCI_RF_INTERFACE_FRAME;
+	(*num)++;
+
+	/* NXP proprietary MIFARE Classic — the NFCC handles crypto-1 auth */
+	cfg[*num].rf_protocol = 0x80;
+	cfg[*num].mode = NCI_DISC_MAP_MODE_POLL;
+	cfg[*num].rf_interface = 0x80;
+	(*num)++;
+
 	for (i = 0; i < ndev->num_supported_rf_interfaces; i++) {
 		if (ndev->supported_rf_interfaces[i] ==
 		    NCI_RF_INTERFACE_ISO_DEP) {
 			cfg[*num].rf_protocol = NCI_RF_PROTOCOL_ISO_DEP;
-			cfg[*num].mode = NCI_DISC_MAP_MODE_POLL |
-				NCI_DISC_MAP_MODE_LISTEN;
+			cfg[*num].mode = NCI_DISC_MAP_MODE_POLL;
 			cfg[*num].rf_interface = NCI_RF_INTERFACE_ISO_DEP;
 			(*num)++;
 		} else if (ndev->supported_rf_interfaces[i] ==
 			   NCI_RF_INTERFACE_NFC_DEP) {
 			cfg[*num].rf_protocol = NCI_RF_PROTOCOL_NFC_DEP;
-			cfg[*num].mode = NCI_DISC_MAP_MODE_POLL |
-				NCI_DISC_MAP_MODE_LISTEN;
+			cfg[*num].mode = NCI_DISC_MAP_MODE_POLL;
 			cfg[*num].rf_interface = NCI_RF_INTERFACE_NFC_DEP;
 			(*num)++;
 		}
@@ -1010,6 +1024,26 @@ static int nci_transceive(struct nfc_dev *nfc_dev, struct nfc_target *target,
 
 	pr_debug("target_idx %d, len %d\n", target->idx, skb->len);
 
+	/*
+	 * NXP proprietary MIFARE Classic auth command reformatting.
+	 * neard sends:  [cmd][block][key 6B][uid 4B]  (12 bytes)
+	 * NXP expects:  [cmd][block][pad 4B][key 6B]  (12 bytes)
+	 * The NFCC already knows the UID from activation, so we drop it
+	 * and move the key to the position the NXP firmware expects.
+	 */
+	if (ndev->target_active_prot == NFC_PROTO_MIFARE &&
+	    skb->len == 12) {
+		unsigned char *d = skb->data;
+		if (d[0] == 0x60 || d[0] == 0x61) {
+			unsigned char key[6];
+
+			memcpy(key, d + 2, 6);     /* save key */
+			memset(d + 2, 0, 4);       /* padding */
+			memcpy(d + 6, key, 6);     /* key at new position */
+			pr_debug("reformatted MIFARE auth for NXP interface\n");
+		}
+	}
+
 	if (!ndev->target_active_prot) {
 		pr_err("unable to exchange data, no active target\n");
 		return -EINVAL;
